---
import Layout from "../../app/layouts/Layout.astro";
import Header from "../../app/components/Header.astro";
import UnifiedSimplePage from "../../app/components/UnifiedSimplePage.astro";
import { siteConfig } from "../../app/config/site";
import {
  loadSimplePageByLang,
  resolvePageSlotByHref,
} from "../../app/lib/content-loader";

const pageKey = resolvePageSlotByHref("zh", Astro.url.pathname);
if (!pageKey) return new Response(null, { status: 404 });

const cfg = loadSimplePageByLang(pageKey, "zh");
---

<Layout title={`${cfg?.heroTitle || "Page"} | ${siteConfig.shortBrand}`} lang="zh-CN">
  <Header />
  <UnifiedSimplePage cfg={cfg} lang="zh" />
  <footer class="bg-[#002845] text-white py-8">
    <div class="max-w-7xl mx-auto px-4 text-center text-sm">
      <p>&copy; {siteConfig.copyrightYear} {siteConfig.companyName} All rights reserved.</p>
    </div>
  </footer>
</Layout>
